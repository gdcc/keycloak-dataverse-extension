<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <!--
        The persistence unit name must be kept in sync with DataverseUserService.java!
        It cannot be made runtime configurable because of how Keycloak works.
     -->
    <persistence-unit name="dataverse-pu" transaction-type="JTA">
        <class>edu.harvard.iq.keycloak.auth.spi.models.DataverseBuiltinUser</class>
        <class>edu.harvard.iq.keycloak.auth.spi.models.DataverseAuthenticatedUser</class>
        <properties>
            <!-- Set the Hibernate dialect for PostgreSQL -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!--
              JDBC connection:
              1. Using a hardcoded name here, which cannot be made runtime configurable without programmatically
                 creating a new persistence unit ourselves.
              2. The source itself is configurable at runtime, see https://www.keycloak.org/server/db#multiple-datasources
            -->
            <property name="jakarta.persistence.jtaDataSource" value="dataverse"/>

            <!-- Transaction management settings -->
            <property name="jakarta.persistence.transactionType" value="JTA"/>

            <!-- Automatically update database schema -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>

            <!-- Disable SQL logging -->
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>

</persistence>
